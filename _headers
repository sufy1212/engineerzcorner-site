# Cloudflare Pages reads this file automatically on every deploy.
#
# 1) CACHING — HTML always revalidates so new deploys show up immediately;
#    hashed static assets are cached hard since they change name when updated.
#
# 2) SECURITY — clickjacking protection, MIME-sniffing protection, and a
#    Content-Security-Policy that allows Google Fonts, Google Tag Manager,
#    and the Adcash (aclib) ad network, while still blocking random
#    third-party domains.
#
#    NOTE ON ADS: ad networks like Adcash serve creatives from many
#    different, sometimes-changing advertiser/exchange domains — that's
#    inherent to how programmatic ad serving works. script-src is kept
#    locked down to the specific Adcash loader domain (acscdn.com), but
#    frame-src/img-src/connect-src had to be relaxed to https: generally
#    so the actual ad creatives (served via iframes from rotating domains)
#    aren't silently blocked. If you want a tighter policy later, check
#    the browser console for the exact blocked domains under real traffic
#    and allowlist those specifically instead of the broad https: rule.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://sibforms.com https://acscdn.com https://*.acscdn.com https://adcash.com https://*.adcash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://sibforms.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://latest.currency-api.pages.dev https://api.frankfurter.dev https://api.frankfurter.app https://open.er-api.com https://api.api-ninjas.com https://sibforms.com https://*.sibforms.com https:; frame-src https://sibforms.com https://*.sibforms.com https:; base-uri 'self'; form-action 'self' https://*.sibforms.com

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These two are generated fresh on every build by scripts/build-recent.js —
# they must NOT inherit the immutable 1-year caching above (Cloudflare Pages
# merges headers from every matching rule, so the broad Cache-Control has to
# be explicitly cleared with "!" before setting a short-lived one here).
/assets/recent.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/site-stats.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/feed.xml
  Cache-Control: public, max-age=3600

/og-image.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
