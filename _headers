# Cloudflare Pages reads this file automatically on every deploy.
#
# 1) CACHING — HTML always revalidates so new deploys show up immediately;
#    hashed static assets are cached hard since they change name when updated.
#
# 2) SECURITY — clickjacking protection, MIME-sniffing protection, and a
#    Content-Security-Policy that allows Google Fonts, Google Tag Manager,
#    and Google AdSense (script, frame and image domains ads need to load
#    and render) while still blocking random third-party domains.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://www.gstatic.com https://adservice.google.com https://sibforms.com https://adtrafficquality.google https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://sibforms.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://cdn.jsdelivr.net https://latest.currency-api.pages.dev https://api.frankfurter.dev https://api.frankfurter.app https://open.er-api.com https://sibforms.com https://*.sibforms.com https://adtrafficquality.google https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://*.google.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://pagead2.googlesyndication.com https://sibforms.com https://*.sibforms.com https://adtrafficquality.google https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; base-uri 'self'; form-action 'self' https://*.sibforms.com

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These two are generated fresh on every build by scripts/build-recent.js —
# they must NOT inherit the immutable 1-year caching above (Cloudflare Pages
# merges headers from every matching rule, so the broad Cache-Control has to
# be explicitly cleared with "!" before setting a short-lived one here).
/assets/recent.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/assets/site-stats.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/feed.xml
  Cache-Control: public, max-age=3600

/og-image.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
